package orm

import std.collections.MutableList

public class Repository<E, I> {
  private RepositoryContext context
  private Class<E> entityType

  Repository(RepositoryContext context) {
    this.context = context
    this.entityType = E.class
  }

  public E save(E entity) {
    this.activeStore().persist(entity)
    return entity
  }

  public E update(E entity) {
    return this.activeStore().merge<E>(entity) ?? entity
  }

  public E? find(I id) {
    return this.activeStore().find<E>(arg0: entityType, arg1: id)
  }

  public Void delete(E entity) {
    this.activeStore().remove(entity)
  }

  public Boolean attached(E entity) {
    return this.activeStore().contains(entity)
  }

  public Void flush() {
    this.activeStore().flush()
  }

  public Void clear() {
    this.activeStore().clear()
  }

  public MutableList<E?>? findAll() {
    QueryExecution<E?>? query = this.activeStore().createQuery<E>(
      arg0: "select entity from " + this.entityName() + " entity",
      arg1: entityType
    )
    return query?.getResultList()
  }

  public MutableList<E?>? findWhere<V>(Field<E, V> field, V value) {
    QueryExecution<E?>? query = this.activeStore().createQuery<E>(
      arg0: "select entity from "
        + this.entityName()
        + " entity where entity."
        + field.name()
        + " = :value",
      arg1: entityType
    )
    query?.setParameter(arg0: "value", arg1: value)
    return query?.getResultList()
  }

  public E? findFirstWhere<V>(Field<E, V> field, V value) {
    QueryExecution<E?>? query = this.activeStore().createQuery<E>(
      arg0: "select entity from "
        + this.entityName()
        + " entity where entity."
        + field.name()
        + " = :value",
      arg1: entityType
    )
    query?.setParameter(arg0: "value", arg1: value)
    query?.setMaxResults(1)
    return query?.getSingleResultOrNull()
  }

  public MutableList<E?>? findWhereOrdered<V, O>(
    Field<E, V> field,
    V value,
    Field<E, O> order,
    Boolean ascending
  ) {
    String direction = " desc"
    if ascending {
      direction = " asc"
    }
    QueryExecution<E?>? query = this.activeStore().createQuery<E>(
      arg0: "select entity from "
        + this.entityName()
        + " entity where entity."
        + field.name()
        + " = :value order by entity."
        + order.name()
        + direction,
      arg1: entityType
    )
    query?.setParameter(arg0: "value", arg1: value)
    return query?.getResultList()
  }

  public MutableList<E?>? page(Integer offset, Integer limit) {
    QueryExecution<E?>? query = this.activeStore().createQuery<E>(
      arg0: "select entity from " + this.entityName() + " entity",
      arg1: entityType
    )
    query?.setFirstResult(offset)
    query?.setMaxResults(limit)
    return query?.getResultList()
  }

  public Long count() {
    QueryExecution<Long?>? query = this.activeStore().createQuery<Long>(
      arg0: "select count(entity) from " + this.entityName() + " entity",
      arg1: Long.class
    )
    return query?.getSingleResultOrNull() ?? 0
  }

  private Store activeStore() {
    return context.store()
  }

  private String entityName() {
    Entity? mapping = entityType.annotation<Entity>()
    if mapping != null && !mapping.name.isEmpty() {
      return mapping.name
    }
    Array<String> names = entityType.name().split(separator: ".")
    return names[names.size() - 1]
  }
}
